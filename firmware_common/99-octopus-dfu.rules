# STM32 ROM DFU bootloader (BTT Octopus in DFU mode) - lets dfu-util/PlatformIO
# flash without sudo. Install:
#   sudo cp 99-octopus-dfu.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
SUBSYSTEM=="usb", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="df11", MODE="0666", TAG+="uaccess"
# STM32duino USB-CDC serial (the running firmware) - normally covered by the
# dialout group already; harmless to have here too.
KERNEL=="ttyACM*", ATTRS{idVendor}=="0483", ATTRS{idProduct}=="5740", MODE="0666"
